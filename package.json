{
  "name": "dsh-cost-overlay",
  "version": "0.2.1",
  "description": "Real-time token and cost overlay plugin for DeepSeek Harness (dsh) — live floating pill in the top-right corner with cache-hit savings, budget alerts, per-turn breakdown, and one-click Markdown cost report export.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "marketplace.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "id": "cost-overlay",
    "name": "Token & Cost Overlay",
    "version": "0.2.1",
    "entry": "./dist/index.js",
    "clientEntry": "./dist/client/overlay.js",
    "slots": [
      "status-bar:right",
      "overlay:top-right"
    ],
    "permissions": [
      "llm:usage:read",
      "ui:overlay:mount"
    ]
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-counter",
    "cost-tracker",
    "llm-observability"
  ],
  "author": "Meatdaemon",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
